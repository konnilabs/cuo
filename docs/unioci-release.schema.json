{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konnilabs/cuo/blob/main/docs/unioci-release.schema.json",
  "title": "UniOCI release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "version",
    "channel",
    "images"
  ],
  "properties": {
    "schema": {
      "const": "unioci.release.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "revision",
        "workflowRunId",
        "runAttempt"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "workflowRunId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
    },
    "channel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "reference",
          "digest"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$"
          },
          "reference": {
            "type": "string",
            "maxLength": 1024
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
