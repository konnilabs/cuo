    serialized "{\"capabilities\":[],\"registries\":[],\"githubConnections\":[],\"subscriptions\":[],\"webhookDeliveries\":[],\"releaseSets\":[],\"importJobs\":[],\"registryRepositories\":[],\"registryTags\":[],\"githubInstallations\":[],\"githubCatalog\":{},\"permissionMatrix\":null,\"registryId\":\"\",\"githubId\":\"\",\"routePath\":\"/dashboard\",\"registryEditor\":\"\",\"githubEditorId\":\"\",\"subscriptionEditorId\":\"\",\"subscriptionTargetCount\":1,\"repository\":\"\",\"artifactReference\":\"latest\",\"artifact\":null,\"artifactOpen\":false,\"integrationBusy\":false,\"integrationQueryBusy\":false,\"integrationQueryError\":\"\",\"integrationRequest\":\"\",\"integrationOperation\":\"\",\"registryStorage\":null,\"retentionPreview\":null,\"processRuns\":[],\"processTotal\":0,\"processUpcoming\":[],\"processKind\":\"run\",\"processQuery\":\"\",\"processStatus\":\"all\",\"processFrom\":\"\",\"processTo\":\"\",\"processOffset\":0,\"processDetail\":null,\"logStorage\":null,\"auth\":\"loading\",\"theme\":\"system\",\"themeMode\":\"system\",\"palette\":\"slate\",\"highContrast\":false,\"language\":\"de\",\"languageAutomatic\":true,\"locale\":\"de\",\"settingsTab\":\"appearance\",\"labels\":{\"u847c81f3\":\"SYS_ADMIN beim Update beibehalten\",\"ue3bd506b\":\"SYS_PTRACE beim Update beibehalten\",\"ue8a02e90\":\"DAC_READ_SEARCH beim Update beibehalten\",\"ube62c224\":\"Host-PID-Zugriff beim Update beibehalten\",\"u47e24725\":\"SYS_ADMIN und Host-PID gewähren weitreichenden Zugriff auf den Host. Nur ein Owner darf diese Freigaben vergeben oder widerrufen. CUO erhält ausschließlich bereits vorhandene Rechte; die Auswahl fügt dem Container keine neuen Rechte hinzu.\",\"u298a2fc7\":\"Nur für eine konkrete Container-Richtlinie. Nicht freigegebene Capabilities, privilegierter Modus, Geräte sowie Host-Netzwerk und Host-IPC bleiben gesperrt. Schreibende System-Mounts und direkte Docker-Sockets sind nicht enthalten.\",\"u28da7161\":\"Ausführungsfreigaben benötigen eine konkrete Container-Richtlinie mit gültiger Ziel-ID.\",\"u589b95a0\":\"Bestehende erweiterte Hostrechte freigeben\",\"uefa70e7f\":\"Erlaubt containerbezogene Freigaben zum Erhalten von SYS_ADMIN, SYS_PTRACE, DAC_READ_SEARCH und Host-PID bei Updates. Fügt keine neuen Container-Rechte hinzu.\",\"ucc069e64\":\"Bestehende Monitoring-Mounts, ausgewählte Capabilities und Host-PID benötigen ausdrückliche containerbezogene Freigaben. Neue Hostrechte werden bei Updates nicht hinzugefügt.\",\"udb0e71fa\":\" überwacht · \",\"ue967d082\":\"„Jetzt prüfen“ vergleicht die laufenden Images mit der Registry. Suche, Filter und sortierbare Tabellen helfen bei der Auswahl.\",\"uadea2aab\":\"* gibt alle Repositories dieser Verbindung frei. Bevorzuge eng begrenzte Repository- oder Namespace-Freigaben. API-Endpunkt und kanonischer Docker-Host dürfen bei einer ausdrücklich konfigurierten internen Verbindung abweichen.\",\"ud07c58\":\"1 bis 4 Updates gleichzeitig. Grenzen der globalen, Host- und Gruppenrichtlinien gelten gemeinsam; ohne globale Einstellung bleibt die Grenze 1. Dienste desselben Compose-Projekts werden zum Schutz des gemeinsamen Sollzustands nacheinander aktualisiert. Übergeordnete Ausschlüsse bleiben wirksam.\",\"ua09c03c8\":\"1. Container erfassen\",\"u6774b93e\":\"2. Updates prüfen\",\"u97706c2b\":\"3 erfolgreich · 1 unverändert\",\"ufbab8d42\":\"3. Richtlinien festlegen\",\"u425d00a0\":\"4. Update-Lauf starten\",\"ue9a32cde\":\"5. Fortschritt verfolgen\",\"ua7e5f83d\":\"6. Workspace anpassen\",\"u2d5d70e9\":\"Abbrechen\",\"u7b28fe77\":\"Abgebrochen\",\"uc5d69534\":\"Abgeschlossen\",\"u4f2a803\":\"Abmelden\",\"u59f8a2fc\":\"Account\",\"uf03099af\":\"Achtung: Monitoring-Mounts geben dem Container Einblick in Host-Prozesse und Systeminformationen. Die Freigabe gilt dauerhaft für Updates dieses Containers, einschließlich automatischer Läufe. Nur für vertrauenswürdige Images aktivieren. Volumes und Anwendungsdaten werden bei einem Fehler nicht automatisch zurückgesetzt.\",\"ua00f5347\":\"Administrator – freigeben und verwalten\",\"ufbfc25dc\":\"Administrator anlegen\",\"uc13726f7\":\"Aktion\",\"ud177f807\":\"Aktion ausführen\",\"u1b35bd79\":\"Aktion fehlgeschlagen\",\"ud7c496ab\":\"Aktion wurde angenommen.\",\"u632436a8\":\"Aktionen\",\"u5b8d1429\":\"Aktionsrechte und zusätzliche Ausführungsfreigaben getrennt verwalten.\",\"u7b4225b8\":\"Aktiv\",\"u6297e5bc\":\"Aktiviert\",\"u5a13c24e\":\"Aktualisieren\",\"u84b9f85\":\"Aktuell\",\"uc37a16ec\":\"Aktuelle Version\",\"u44e25a93\":\"Alle\",\"u4aad7f78\":\"Alle anzeigen\",\"u4cd8fc5c\":\"Alle Container\",\"ufdc9735c\":\"Alle löschen\",\"u9cffa62f\":\"Alle überwachten Container und ihr Update-Status.\",\"u2acfaca8\":\"Alles erledigt\",\"u7f1f72c2\":\"Alles in Ordnung\",\"ub3f74eb4\":\"Alt + K\",\"u3233231d\":\"Ältere Protokolle dieses Laufs wurden gelöscht. Lauf-ID, Status, Snapshots und gespeicherte Phasenzeiten bleiben erhalten.\",\"u4f132274\":\"Änderung der Berechtigungen bestätigen\",\"udf142039\":\"Änderung gespeichert.\",\"ueca96997\":\"Änderungsgrund\",\"u10a4348f\":\"Anforderer\",\"uc8b2e32f\":\"Anfrage fehlgeschlagen\",\"ua85d2c2e\":\"Angelegt\",\"ue15bd32f\":\"Anmelden\",\"u5b463228\":\"Anmeldung\",\"u9feee613\":\"Anomalien & Datenqualität\",\"u2ff8137a\":\"Anzeige\",\"u3b54c801\":\"Anzeigename\",\"uec85c16a\":\"Anzeigesprache\",\"u81f51acc\":\"App\",\"u6081d23a\":\"Artefakt öffnen\",\"uc85fcf5c\":\"Auf GitHub installieren\",\"u16007413\":\"Aufbewahrter Vorgänger\",\"u12a15b97\":\"Aufbewahrter Vorgänger für manuelle Wiederherstellung\",\"u5ec8cb7b\":\"Aufbewahrung gespeichert.\",\"u40eb61e5\":\"Aufbewahrung speichern\",\"u5a84e509\":\"Auffällig\",\"u13c1b1dc\":\"Aufmerksamkeit nötig\",\"u9cf5668c\":\"Ausführung benötigt zusätzlich cuo.managed=true am Container. Die globale Standardeinstellung ist „Nur prüfen“.\",\"u4ca569a6\":\"Ausführungsdauer\",\"u47ea12c6\":\"Ausführungsfreigabe: lesendes Host-Monitoring\",\"uc7c7456c\":\"Ausführungsrechte\",\"u86655ea2\":\"Ausgeschlossen\",\"uef122269\":\"Ausnahmen\",\"u365179a3\":\"Ausnahmen als Datum, mit Komma trennen\",\"u79e30d6b\":\"Ausschlüsse filtern\",\"u84eee7d7\":\"Automatik aus\",\"ud9c2c3a7\":\"Automatisch\",\"u7c0053d8\":\"Automatisch aktiv\",\"u5948f508\":\"Automatisch gemäß Container-Richtlinien\",\"u3dcece99\":\"Automatische Log-Rotation aktivieren\",\"udf3cabdb\":\"Automatische Planung\",\"u2151accf\":\"Barrierefreiheit\",\"u4fb77790\":\"Bearbeiten\",\"u4c6015bc\":\"Beendet\",\"u978f1883\":\"Begründung\",\"u630dae2a\":\"Bei automatischer Anlage erhalten alle vom Provider zugelassenen Benutzer diese Rolle auf dem lokalen Host. Bestehende Rollen werden beibehalten.\",\"ud5523e11\":\"Beispieldaten; keine gemessene Telemetrie.\",\"udcfc56d0\":\"Benachrichtigung schließen: \",\"u19bbab9f\":\"Benachrichtigungen\",\"u87c2e7ed\":\"Benachrichtigungen schließen\",\"uc1ed06b0\":\"Benutzer\",\"u9795870b\":\"Benutzer angelegt.\",\"uaa410356\":\"Benutzer anlegen\",\"uf43114d1\":\"Benutzer speichern\",\"uac034a33\":\"Benutzername\",\"u23d6cb4c\":\"Berechtigungen speichern\",\"u555afbb0\":\"Berechtigungsmatrix wird geladen …\",\"u2d38aba2\":\"Bereinigung, Reset und Speicherfreigabe\",\"u21675abc\":\"Bereit\",\"ua3ba7f9f\":\"Beschriftung der Anmeldung\",\"u6fdae060\":\"Bestandsabgleich\",\"u254619d\":\"Bestätige zuerst den Warnhinweis zum Host-Zugriff.\",\"ubef7bbc8\":\"Bestehende lesende Host-Mounts für Monitoring zulassen\",\"u4f96be98\":\"Betroffene Container\",\"u5ceacce4\":\"Bitte auswählen\",\"ue1caf2ec\":\"Bitte gib einen Freigabegrund mit mindestens drei Zeichen an.\",\"u5627a393\":\"Bitte zuerst ein Repository auswählen\",\"ucc192185\":\"Cache\",\"u946645c1\":\"Client-Secret (gespeichert; leer lassen zum Beibehalten)\",\"u673dcdbf\":\"Client-Secret im Request-Body\",\"uc0821b1e\":\"Cloud\",\"u18049f93\":\"Compose\",\"ud3fb4ee8\":\"Compose: zusätzlich cuo.compose.file relativ zum registrierten Projektverzeichnis setzen.\",\"ub23d4718\":\"Container\",\"ua3d5e8f7\":\"Container ausschließen\",\"ud07c76bf\":\"Container auswählen\",\"u713095fc\":\"Container filtern\",\"ue0215da6\":\"Container hinzufügen\",\"u77ae2eac\":\"Container in Warteschlange (automatisch)\",\"u8ee3d320\":\"Container in Warteschlange (manuelle Freigabe)\",\"u91d3b74e\":\"Container mit Docker oder Compose anlegen.\",\"u21666420\":\"Container suchen\",\"u597ed286\":\"Container suchen ...\",\"u28907cfb\":\"Container Update Orchestrator\",\"u9e31cd3b\":\"CONTAINER UPDATE ORCHESTRATOR\",\"u35fe98ed\":\"Container werden neu erstellt und sind kurzzeitig nicht erreichbar. Datenbanken und Volumes werden nicht zurückgesetzt. Einzeljobs beachten Freigaben und Wartungsfenster. „Alle auswählen“ startet als bestätigter Administrator-Sofortlauf außerhalb der Wartungsfenster und gibt die ausgewählten Updates frei; Ausschlüsse und Parallelitätsgrenzen bleiben wirksam. Ein fehlgeschlagener Healthcheck erfordert einen manuellen Eingriff.\",\"u3657b35d\":\"Container-Namen, Image-Referenzen und gespeicherte Logs behalten ihren Originaltext.\",\"uc3d8b4bc\":\"Container, Images, Tags oder Events suchen ...\",\"ub8bdab5f\":\"Containerbestand\",\"ue1b2832d\":\"CUO 0.3.1 · Go Core · XTend Maraca / RMT\",\"u4dcb52\":\"CUO 0.3.1 wird unter der Apache License 2.0 bereitgestellt. Die Anwendung und ihre Ressourcen enthalten Komponenten Dritter mit eigenen Lizenzbedingungen. Produktnamen und Marken gehören ihren jeweiligen Inhabern.\",\"ue3e4e6dd\":\"CUO Core\",\"u3b69951a\":\"CUO Dashboard\",\"u3864290b\":\"CUO entdeckt Container auf dem lokalen Docker-Host automatisch. Die App erstellt keine beliebigen neuen Workloads.\",\"u1927c9d3\":\"CUO nach deinen Anforderungen konfigurieren.\",\"u58d1b53f\":\"CUO Systemaktivität\",\"ud2bc4b5f\":\"CUO wird gestartet …\",\"ucdc3119a\":\"Darstellung\",\"u11f6d87b\":\"Dashboard\",\"ueec80313\":\"Dateiformat\",\"u6629a587\":\"Datenbank\",\"uade5662c\":\"Datenbank komprimiert.\",\"u18556cc\":\"Datenbereinigung ist in der Design-Demo deaktiviert.\",\"u8936ed40\":\"Datenbestand\",\"uc7b30eac\":\"Datenstand herunterladen\",\"ud0c110d2\":\"Dauer\",\"uc94dbd77\":\"Dauer in Minuten\",\"u593cfe81\":\"Dauerhafte Laufhistorie\",\"u9c37971b\":\"Dauerhafte Zustellungen und ihr Verarbeitungsstatus.\",\"u178a88d1\":\"Deaktiviert\",\"u5feb89fd\":\"Dein Profil\",\"ufa4090b0\":\"Dein Profil öffnen\",\"ue2186d6e\":\"Deine Auswahl wird im Profil gespeichert.\",\"uda9502d6\":\"Deine Rolle und Host-Berechtigungen werden vom Administrator verwaltet.\",\"u47678\":\"Deinen Workspace einrichten\",\"u9326777d\":\"Der Inhalt wurde anhand seines Digests abgeglichen. Eine kryptografische Herkunfts- oder Signaturverifikation ist damit nicht belegt.\",\"u12da7d01\":\"Der Owner kann einen beliebigen OIDC-Provider konfigurieren.\",\"u7587fdcc\":\"Der Provider liefert aktuell keine zugängliche Referrers-Liste.\",\"ue11aa885\":\"Design-Demo · Beispieldaten · Aktionen ohne Docker-Ausführung\",\"uc9f38d37\":\"Design-Demo ansehen\",\"uf22698a\":\"Design-Demo: Änderungen sind deaktiviert. Zur Live-Ansicht wechseln.\",\"uec24245\":\"Details\",\"uf718cdde\":\"Details anzeigen\",\"uf41f19e3\":\"Deutsch\",\"u75e7ece7\":\"Dialog schließen\",\"uc630ee86\":\"Die Aufbewahrung und Datenbereinigung kann nur ein Owner konfigurieren.\",\"uff9459c6\":\"Die erste unterstützte Browsersprache wird verwendet. Für andere Sprachen wird Englisch angezeigt.\",\"ub17c60da\":\"Die GitHub-App dient dem API-Zugriff und den Webhooks. Für private GHCR-Pulls wird zusätzlich eine Registry-Verbindung mit PAT classic und read:packages benötigt. CUOs Benutzeranmeldung bleibt davon unabhängig.\",\"u82214335\":\"Die integrierte Registry wird lokal über tools/install.sh --with-registry bereitgestellt. Ein lokaler HTTP-Endpunkt ist ausschließlich für diesen PC und das isolierte Docker-Netz bestimmt; für externe CI ist ein eigener HTTPS-Ingress erforderlich.\",\"uf1ebad2\":\"Die manuelle Sprache wird in deinem Profil gespeichert.\",\"uadbb1b01\":\"Die Matrix wird im Backend durchgesetzt. Host-/Container-Grenzen und Ausführungsprüfungen gelten zusätzlich. Die Owner-Verwaltung bleibt geschützt; eine Checkbox erteilt keinen allgemeinen Shell- oder Docker-Zugriff.\",\"u1c53d8c8\":\"Die Shell unterstützt Tastaturnavigation und berücksichtigt reduzierte Bewegung sowie erzwungene Systemfarben.\",\"u66bda35f\":\"Diese Aktionen entfernen Protokolldaten unwiderruflich. Logs offener Jobs, Lauf-IDs, Status, Snapshots und Agent-Journale bleiben erhalten. Zuvor bei Bedarf exportieren. Komprimierung ist nur ohne offene Jobs möglich.\",\"u3f2f2f97\":\"Diese Ansicht ist eine Vorschau. Änderungen und Verbindungen benötigen die Live-Instanz.\",\"ubde9ac20\":\"Diese Freigabe erlaubt Netzwerkzugriff auf das angegebene Ziel. TLS wird bei externen Registries weiterhin geprüft; es gibt keinen Schalter zum Abschalten der Zertifikatsprüfung.\",\"u35531611\":\"Diese Instanz ist nur lokal erreichbar. Webhooks benötigen einen öffentlichen HTTPS-Eingang; der ausgehende Polling-Abgleich funktioniert auch ohne ihn.\",\"u12bea3fd\":\"Digest\",\"uf6574098\":\"Direkt aus Quell-Registry beziehen\",\"uf9402ded\":\"Docker\",\"udec7c9\":\"Docker Engine\",\"uc9f05adf\":\"Docker-Inventar aktualisiert.\",\"u27771d81\":\"Docker-Zugriff über den internen CUO-Agent. Socket bleibt innerhalb der Ausführungsgrenze.\",\"u682a4848\":\"Downloads sind in der Live-Ansicht verfügbar.\",\"u801d5e5b\":\"Dunkles Farbschema\",\"ub52947bb\":\"Eigene CA (PEM, optional)\",\"u4ac5db88\":\"Eigene GitHub-App, ausgewählte Repositories und erfolgreiche Publish-Workflows.\",\"u79f83404\":\"Ein Import schreibt dieselben OCI-Inhalte per Digest in die Ziel-Registry. Referrers werden mit übertragen. Ein Container-Update wird dadurch nicht automatisch freigegeben.\",\"u3090fa9f\":\"Eindeutige Lauf-IDs, Ausführungsphasen und nächste geplante Prüfungen.\",\"u4bf48e88\":\"Eingang\",\"u9d9a854c\":\"Eingeplant\",\"ue7aeb90e\":\"Eingriff erforderlich\",\"u9412d96a\":\"Einstellungen\",\"udce60bad\":\"Einstellungen öffnen\",\"u1668f3d9\":\"Einstellungsbereiche\",\"u94af7df8\":\"Eintrag ist nicht mehr im aktuellen Inventar vorhanden.\",\"u8db101dd\":\"Einzelne Jobs\",\"u1b9ae0bb\":\"English\",\"uc4d5a501\":\"Ereignis\",\"u9bebecd9\":\"Ereignisgesteuert\",\"u3762c13f\":\"Erfolgreich\",\"ub7a82b4e\":\"Ergebnis\",\"u2648ed75\":\"Erlaubte Auth-Realm-Hosts\",\"u8e1f787a\":\"Erlaubte Blob-/Download-Hosts\",\"ua69046b\":\"Erlaubter Branch / Tag-Muster\",\"u353d53af\":\"Erwartetes Image-Repository\",\"ua82bcf98\":\"Erweiterte Ausführungsfreigaben\",\"u2dd80cb9\":\"Explizit ausschließen\",\"uccc9c0eb\":\"Externe OCI-Registries und die integrierte Zot-Registry über einen gemeinsamen Vertrag verwalten.\",\"u70673d9e\":\"Fähigkeiten nach Benutzerrolle\",\"u80bdc5fb\":\"Farbfamilie\",\"ue622197d\":\"Farbschema wechseln: Dunklen Modus aktivieren\",\"u6974c38c\":\"Farbschema wechseln: Hellen Modus aktivieren\",\"uc6dad8bf\":\"Fehler\",\"ua4f9fdc6\":\"Fehlerhafter Zustand\",\"u3b4ca809\":\"Fehlgeschlagen\",\"ufeeef63e\":\"Fenster erstellen\",\"u300fb513\":\"Fenster speichern\",\"u2638b523\":\"Filter anwenden\",\"u185567b3\":\"Folgt der Systemeinstellung.\",\"uda26818a\":\"Formular ist abgelaufen. Bitte erneut absenden.\",\"uf14c1b6e\":\"Formular nicht verfügbar\",\"u1792eff7\":\"Freien Datenbankspeicher komprimieren\",\"u154ec3c0\":\"Freigabe ausstehend\",\"u3ee957c3\":\"Freigabe erforderlich\",\"ubfca18ac\":\"Freigabegrund\",\"ud948d680\":\"Freigeben\",\"u956ade6d\":\"Für diesen Tag ist nichts geplant\",\"uf9c7efe5\":\"Für diesen Zeitpunkt wurde kein Snapshot erfasst.\",\"u1ce2d849\":\"Für Updates das Label cuo.managed=true setzen.\",\"u73caf10e\":\"Gefundene Läufe\",\"ud80843b4\":\"Geltungsbereich\",\"ud9b0a256\":\"Geplant\",\"u1ba38671\":\"Geplante Ausführungen\",\"u1988709a\":\"Geschlossene Meldungen bleiben für dein Konto ausgeblendet.\",\"u245fb8ea\":\"Gespeicherte Pull-Credentials entfernen\",\"uc78f6999\":\"Gespeicherte Push-Credentials entfernen\",\"uf3c9e21d\":\"Gespeichertes Client-Secret entfernen\",\"u8603e5ea\":\"Gestartet\",\"ua238565d\":\"Gestoppt\",\"ud58280ab\":\"Gesund\",\"u91aaae5a\":\"Getrennt\",\"u7018c5ac\":\"Getrennter Push-Zugang für OCI-Importe\",\"ub22dd5f2\":\"GitHub\",\"u4c66ce88\":\"GitHub Container Registry\",\"u9572e76\":\"GitHub Inbox\",\"u759713c5\":\"GitHub Notification Inbox\",\"uc1782dd3\":\"GitHub verbinden\",\"ufa56d6c7\":\"GitHub wird abgefragt …\",\"ua743d0fa\":\"GitHub-App anlegen\",\"u89a5e826\":\"GitHub-Einrichtung abgeschlossen. Installation und Verbindung prüfen.\",\"u435c4f91\":\"GitHub-Einrichtung fehlgeschlagen oder abgelaufen. Bitte erneut starten.\",\"uf385f82\":\"GitHub-Quelle auswählen\",\"u641280ce\":\"Global\",\"ue7d171c7\":\"Global → Host → Gruppe → Container. Ausschlüsse bleiben wirksam.\",\"ud5e988a3\":\"Globale Suche\",\"ud542ae72\":\"Gruppe\",\"u16d92baf\":\"Hauptnavigation\",\"u3c3dd4a1\":\"Healthcheck\",\"ub9971f18\":\"Herunterladen\",\"ucea3a9da\":\"Hilfe und Lizenzen öffnen\",\"ub04416d4\":\"Hinweis\",\"u2c2fb8a3\":\"Hinweise\",\"uffaa982b\":\"Hoher Kontrast\",\"u302af18f\":\"Host\",\"ucf9aefb4\":\"Hosts\",\"u8a45e557\":\"HTTP Basic\",\"u9f324949\":\"IANA-Zeitzonen · Sommerzeit berücksichtigt\",\"u98224d42\":\"Ich bestätige App, Installation und die angezeigten Zugriffsrechte.\",\"u805062d6\":\"Ich bestätige den Abbruch.\",\"ucf0c5081\":\"Ich bestätige den Neustart und die mögliche Unterbrechung.\",\"u72265358\":\"Ich bestätige den Schreibzugriff auf die Ziel-Registry.\",\"ue7907fcf\":\"Ich bestätige die Änderungen der wirksamen Rollenrechte.\",\"ua7912379\":\"Ich bestätige die Ausführung und mögliche Unterbrechung.\",\"uaa92a7d7\":\"Ich bestätige die gewählte Datenbereinigung.\",\"u2856dfe\":\"Ich bestätige Quellen, Container-Zuordnung und den gewählten Automationsmodus.\",\"u46760606\":\"Ich bestätige Ziel, Repository-Freigaben und den Umgang mit Zugangsdaten.\",\"u162d92d4\":\"Ich bestätige, dass abgelaufene Logs nach dieser Regel gelöscht werden dürfen.\",\"ude30a391\":\"Ich habe die Auswirkungen geprüft und bestätige den Host-Zugriff.\",\"u378948b8\":\"Ignoriert\",\"uff6e8e5\":\"Im Profil stellst du Name, Icon, Farbschema und Benachrichtigungen ein. Die Glocke öffnet das Notification Center. Der Owner konfiguriert unter Integrationen OIDC und die lokale Anmeldung.\",\"u590ca79a\":\"Image\",\"ud4dd8f04\":\"Image laden\",\"u5120c1bc\":\"Import einplanen\",\"u3b3fff41\":\"In Arbeit\",\"uab213f\":\"In Ausführung\",\"u6e8df6d2\":\"In Warteschlange\",\"u36465e47\":\"Infrastruktur\",\"u25e69634\":\"Initialen\",\"u377951a4\":\"Initiales Passwort\",\"u4cd57e4d\":\"Installation\",\"ua6d5c3aa\":\"Installation auswählen\",\"u6b07d0c\":\"Installationen laden\",\"uc4ff4c02\":\"Integrationen\",\"u9cacfa47\":\"Interner Host-Agent mit expliziter Container-Freigabe.\",\"ua43175cd\":\"Invalid notices\",\"u37ea54fb\":\"Inventar aktualisieren\",\"u5aad4924\":\"Inventar aktualisieren und eine Update-Richtlinie wählen.\",\"ua985e2c5\":\"Ja – registriertes Projekt benötigt\",\"ufa545c34\":\"Jetzt abgleichen\",\"u56886b19\":\"Jetzt nach Regel rotieren\",\"u1bfaca5e\":\"Jetzt nach Updates suchen\",\"ud480717d\":\"Jetzt prüfen\",\"u6297efba\":\"Job abbrechen\",\"u8eccfa78\":\"Job aktualisiert.\",\"ud114b896\":\"Kalender öffnen\",\"ua4cd4f38\":\"Kanonischer Registry-Host\",\"u68ebcdc7\":\"Kein Fenster\",\"u2f83df16\":\"Kein Fenster geplant\",\"u800a60ec\":\"Kein Update bekannt\",\"uc794c526\":\"Kein Update verfügbar\",\"ucd867a09\":\"Keine\",\"u60b0106f\":\"Keine Auffälligkeit erkannt\",\"u8a31d654\":\"Keine Container gefunden.\",\"ua9e66203\":\"Keine Fehler · 0 ausstehende Jobs\",\"u562d4591\":\"Keine freigegebenen Kandidaten. Erst Updates prüfen und die Richtlinie konfigurieren.\",\"u3ff12a82\":\"Keine neuen Update-Benachrichtigungen.\",\"ub0608c7b\":\"Keine passenden Läufe vorhanden.\",\"u1bcb4382\":\"Keine regelbasierten Auffälligkeiten erkannt. Zeitvergleiche benötigen mindestens drei frühere erfolgreiche Läufe derselben Container.\",\"ua01f12e7\":\"Keine Release-Subscription zugeordnet. Die Registry-Verbindung wird anhand von Host und Repository ausgewählt.\",\"u438be2fd\":\"Keine zugehörigen Protokolle verfügbar.\",\"u4b2ce0e\":\"Keines\",\"u1c719c87\":\"Kennung\",\"u84c7742b\":\"Komponente hinzufügen\",\"u71938c8e\":\"Komponentenname im Release-Set\",\"ua2672fb1\":\"Konfiguration\",\"u1f5a6655\":\"Laufdetails\",\"udfad5ff4\":\"Laufdetails werden geladen\",\"u1c1eb580\":\"Laufende Jobs werden beim Fensterende nicht unterbrochen. Vergangene Fenster werden nicht nachgeholt.\",\"u3357130e\":\"Laufhistorie\",\"u217e3523\":\"Laufprotokoll\",\"uead6ebaa\":\"läuft\",\"u8078bc28\":\"Laufzustand\",\"uc93cb583\":\"Lege den ersten lokalen Administrator an. Deine Daten bleiben auf diesem Host.\",\"ubdcbac07\":\"Letzte Importe\",\"ue1760bd7\":\"Letzte Update-Läufe\",\"u16cdd641\":\"Live-Ansicht öffnen\",\"uff373ba4\":\"Lizenzliste konnte nicht geladen werden. Lade die Seite neu oder verwende den Download-Link.\",\"u7d488e28\":\"Lizenzliste wird geladen …\",\"u51a96da6\":\"Logs\",\"uba60b727\":\"Logs abgeschlossener Prozesse zurücksetzen\",\"ua17d39a0\":\"Lokal\",\"ua5fbe1a4\":\"Lokal gebautes Image ohne veröffentlichten Digest.\",\"u42426287\":\"Lokal installiert · sichere Sitzung\",\"ucce6cf06\":\"Lokale Anmeldung mit Benutzername und Passwort erlauben\",\"u87cf4b68\":\"Lokale Benutzer, Rollen und Host-Berechtigungen verwalten.\",\"u652fab84\":\"Lokale Dienste und optionale Integrationen.\",\"u4063d845\":\"Lokale Installation\",\"u85a6b9a2\":\"Lokaler Docker-Host\",\"uda9fd136\":\"Management\",\"u59ed1\":\"Manifestgröße\",\"u87d8b37b\":\"Manuelle Freigabe\",\"ua3bdd182\":\"Maximal 10.000 Zeilen / 16 MiB pro Download. Bei größeren Datenständen Zeitraum eingrenzen. Excel enthält zusätzlich Exportzeit und Filter.\",\"u3b860642\":\"Maximale Ereigniszahl\",\"u78dbf1ed\":\"Maximale Parallelität\",\"ubb8ac028\":\"Maximales Alter (Tage)\",\"ue8e53b13\":\"Medien\",\"ucec36d2c\":\"Medientyp\",\"u7404d9a4\":\"Melde dich an, um deine Container zu verwalten.\",\"u514e9251\":\"Mindestens 12 Zeichen. Das Konto erhält die Rolle Owner.\",\"u9d8c5478\":\"Mit SSO anmelden\",\"uc3078d01\":\"Monat wechseln\",\"u75799830\":\"Nach nächster Prüfung\",\"u7d6956fa\":\"Nachher\",\"u2de06c1c\":\"Nächste Ausführungen\",\"u68a6158c\":\"Nächster Start\",\"u3cc78ab4\":\"Nächster Update-Lauf\",\"ufe07306\":\"Name\",\"ua27f13dd\":\"Navigation ausklappen\",\"u3e6dc848\":\"Navigation einklappen\",\"u6c605e74\":\"Navigation ist noch nicht bereit\",\"u21f575ca\":\"Navigation nicht bereit\",\"ud26ec8f9\":\"Navigation schließen\",\"uc90c0893\":\"Nein\",\"uaa2bcafc\":\"Nein – cuo.managed=true benötigt\",\"u8df7a5c\":\"Netzwerk und Zertifikate\",\"u5ddb2c2b\":\"Neue SSO-Benutzer automatisch anlegen\",\"u3faf9bf3\":\"Neue Subscription\",\"ua1b249\":\"Neue Subscriptions starten ab ihrer Einrichtung. Frühere Releases werden nicht automatisch ausgerollt. Vollständige Image-Sets werden geprüft; mehrere Container werden nacheinander aktualisiert. Bei einem Fehler hält die Folge an. Anwendungsdaten werden nicht automatisch zurückgesetzt.\",\"u7a129324\":\"Neue Verbindung\",\"u32b5982e\":\"Neuerstellung\",\"u3af5e30e\":\"Neues Fenster\",\"u60e80ba6\":\"Neues Image verfügbar: 1.27.2 → 1.27.3\",\"ud33cbf1c\":\"Neues Image verfügbar: 29.0.7 → 29.0.8\",\"ua0244f2b\":\"Neues Pull-Passwort / Token (bereits hinterlegt)\",\"u69e1c654\":\"Neues Push-Passwort / Token (bereits hinterlegt)\",\"u354b707\":\"Neues Wartungsfenster erstellen\",\"u77401b58\":\"Neustart läuft\",\"u7b3caff8\":\"Neustart muss bestätigt werden.\",\"ud75db95e\":\"Nicht aktiv\",\"u56d23c76\":\"Nicht aktiviert\",\"uc3ad5b18\":\"Nicht eingerichtet\",\"u75dc6c20\":\"Nicht erreichbar\",\"uecd5c5ec\":\"Nicht gestartet\",\"u4e787085\":\"nicht hinterlegt\",\"uf8bf787b\":\"Noch kein vollständiges Release-Set angenommen.\",\"ub583ca33\":\"Noch keine Container. Docker-Inventar aktualisieren.\",\"uae8bbcf3\":\"Noch keine Importe.\",\"u45c3a08b\":\"Noch keine Registry verbunden.\",\"u343e781c\":\"Noch keine Tags geladen. Ein bekannter Digest kann direkt geprüft werden.\",\"ucb559f52\":\"Noch keine Update-Läufe. Neue Jobs erscheinen hier.\",\"ub330030f\":\"Noch keine Zustellungen. Lokal kann der periodische API-Abgleich ohne öffentlichen Webhook-Eingang genutzt werden.\",\"u992fdd4f\":\"Noch nicht geprüft\",\"ubfe128bc\":\"Notices unavailable\",\"u5cfb6a6b\":\"Nur bei Reset: LOGS LÖSCHEN\",\"u10527bbc\":\"Nur ein Owner darf Rollenberechtigungen verwalten.\",\"u89419f54\":\"Nur für eine Container-Richtlinie. Quelle, Ziel und Readonly-Status werden erhalten. Schreibende System-Mounts und Docker-Sockets benötigen einen eigenen, derzeit nicht unterstützten Freigabetyp. Die Änderung benötigt die Fähigkeit „Lesenden Host-Monitoring-Zugriff freigeben“.\",\"ueef36dfd\":\"Nur prüfen\",\"u648d74c9\":\"Nur SSO\",\"u302f993d\":\"OCI Registry\",\"u927a1d25\":\"OCI-Registry; vorhandene Digest-Pins werden beachtet.\",\"u69a05414\":\"Öffentlicher Client (PKCE)\",\"u9239bfb2\":\"Öffnen\",\"u42725b47\":\"Ohne lokale Anmeldung zeigt der Login nur SSO; auch der Passwort-Endpunkt wird gesperrt. Aktiviere dies erst nach einem erfolgreichen SSO-Test. Bei Provider-Ausfall und für lokale Owner-Konten lässt sich der Zugang ausschließlich über das Host-Terminal wiederherstellen: ./tools/recover-login.sh. Bestehende Sitzungen bleiben gültig.\",\"u3f7a42ab\":\"OIDC-Konfiguration gespeichert und Discovery geprüft.\",\"u7e2b0fa\":\"OpenID Connect\",\"u118724f0\":\"Operator – prüfen und Jobs anlegen\",\"u25eeb60\":\"Optional vorab nach Zot importieren\",\"ucc50045c\":\"Organisation (leer für persönlichen Account)\",\"u3cc32168\":\"Passwort\",\"ufbee39c2\":\"Pausiert\",\"u85e21705\":\"Persistenter Lauf\",\"uc36eeba0\":\"Person\",\"u325b86c1\":\"Plane sichere Updates zu einer passenden Zeit.\",\"u2032acae\":\"Planungsvorschau\",\"uecf95e06\":\"Plattform\",\"u5608af15\":\"Plattformen\",\"uee2b5d56\":\"Privater RSA-App-Schlüssel (PEM; leer behält den bisherigen)\",\"ubd80d943\":\"Produktiv\",\"u271cfea2\":\"Profil gespeichert.\",\"u777706d2\":\"Profil speichern\",\"udd7ae522\":\"Protokolle\",\"u21edc2cb\":\"Protokolle anzeigen\",\"ue4f604fb\":\"Protokollereignisse\",\"u35a888dc\":\"Provider\",\"u9aea3216\":\"Prozesse\",\"ua660e9b6\":\"Prozesse filtern\",\"u5f7535be\":\"Prozessmanager\",\"ud96e9525\":\"Prüfe nextcloud:stable ...\",\"uc081b83b\":\"Prüfe nginx:stable ...\",\"u3b808d31\":\"Prüfe postgres:17 ...\",\"u4ecb642a\":\"Prüfe redis:7 ...\",\"u730d35ca\":\"Prüfen\",\"ua088f649\":\"Prüfung fehlgeschlagen\",\"u1e58197a\":\"Redirect-URI für den Provider\",\"u6ba24cc9\":\"Referenzartefakte\",\"u82cef2f6\":\"Registries\",\"u6ad53ad1\":\"Registries öffnen\",\"uc7923e4f\":\"Registry nicht gefunden oder nicht zugänglich.\",\"ue289a83f\":\"Registry verbinden\",\"ufce4410b\":\"Registry wird abgefragt …\",\"uf0a046bb\":\"Registry-Prüfung\",\"uac743329\":\"Repositories\",\"u4dd1584b\":\"Repositories laden\",\"u9ac76a1\":\"Repositories und Artefakte\",\"ue763c8b5\":\"Repository\",\"ufcdcf070\":\"Repository und Publish-Workflow mit deinen Containern verbinden.\",\"ud6fc86ba\":\"Repository zuerst aus der freigegebenen Liste auswählen\",\"u3dfc5173\":\"Repository-Freigaben (eine pro Zeile oder mit Komma getrennt)\",\"u35068bd6\":\"Richtlinie\",\"u269f4444\":\"Richtlinie & Freigabe bearbeiten\",\"u16d1898\":\"Richtlinie anlegen\",\"ub6676677\":\"Richtlinie bearbeiten\",\"u17246875\":\"Richtlinie gespeichert.\",\"u8cf5583f\":\"Richtlinie speichern\",\"u314df2a8\":\"Richtlinien\",\"ub8d1f43c\":\"Richtlinien für globale, Gruppen- und Container-Einstellungen.\",\"u54893a41\":\"Rolle\",\"ua1c473bb\":\"Rolle für neue SSO-Benutzer\",\"ueac9840b\":\"Rollen und Host-Berechtigungen werden serverseitig geprüft. Sitzungen sind nach zwölf Stunden ungültig.\",\"u80c8d99\":\"Rollenberechtigungen\",\"u5c7b0168\":\"Schild\",\"ue1cab4a5\":\"Schließen\",\"u4537da31\":\"Schnellaktionen\",\"ubcee84b1\":\"Schwarz\",\"u3bb28568\":\"Scopes\",\"u706e4124\":\"Seite wechseln\",\"udfcbbe43\":\"Sicherheit\",\"u1c188e95\":\"Sitzung\",\"uc881c6a5\":\"Sitzungen widerrufen\",\"u2f4b8cd1\":\"Sitzungen widerrufen.\",\"u9637e38e\":\"Slate\",\"u45b07556\":\"Sommerzeit: übersprungene Uhrzeiten werden auf die nächste gültige Minute verschoben; doppelte Uhrzeiten werden einmal ausgeführt. Vergangene Fenster werden nicht nachgeholt.\",\"u13a81eed\":\"Speicherinformationen\",\"u2b4c700a\":\"Speichern\",\"u7ca6d0fa\":\"Speichern und Verbindung prüfen\",\"u99efb25b\":\"Sprache\",\"u248e5123\":\"Sprache automatisch vom Browser übernehmen\",\"u6d7cf3b1\":\"SQLite-Speicher und Agent-Journale liegen in persistenten Docker-Volumes.\",\"uc7578208\":\"SSO-Anmeldung aktivieren\",\"ub5214a34\":\"SSO-Anmeldung fehlgeschlagen oder abgelaufen. Bitte erneut versuchen oder den Betreiber kontaktieren.\",\"ue3ee2645\":\"SSO-Anmeldung fehlgeschlagen oder abgelaufen. Bitte erneut versuchen oder lokal anmelden.\",\"u16ab68\":\"Standard\",\"uae8097f\":\"Start\",\"ubac3c043\":\"Startzeit\",\"u5ef20f\":\"Status\",\"ud39e3a81\":\"Status (Läufe / Jobs)\",\"u7535f404\":\"Statusmeldungen\",\"u258160d7\":\"Subscription aktiv\",\"uaa1d9745\":\"Subscriptions\",\"u72758ec8\":\"Subscriptions öffnen\",\"u7f27fcb2\":\"Suche nach Name oder Lauf-ID\",\"u62eb735d\":\"Suchtext\",\"u8240a6c3\":\"Systemaktivität (Live)\",\"u26888754\":\"Systemaktivität und nachvollziehbare Audit-Ereignisse.\",\"u8a5b71a6\":\"Systemstatus\",\"u954810a3\":\"Systemzustand\",\"uc8db704f\":\"Tag oder Digest\",\"ufcbdc346\":\"Tags laden\",\"ucaf831fc\":\"Teilweise aktualisiert · Eingriff erforderlich\",\"u42b75e\":\"Teilweise fehlgeschlagen\",\"u950196fc\":\"Tools\",\"ufb94323d\":\"Übersicht\",\"u5cb4e51d\":\"Übersicht über deine Container, Updates und den Systemstatus.\",\"u324684fe\":\"Übersprungene Container\",\"uf0439746\":\"Unbekannte Aktion\",\"uede157c4\":\"Unbekannte Ansicht\",\"u79e05125\":\"Unbekannte Integrationsaktion\",\"u87522954\":\"Unbekanntes Integrationsformular\",\"u1a58f516\":\"Ungeprüft\",\"ufce59100\":\"Ungültige Farbfamilie\",\"u8baa8578\":\"Ungültige Komponentenquelle\",\"ucbdd1dd8\":\"Ungültige Sprache\",\"u42b06ae3\":\"Ungültiges GitHub-Ziel\",\"uefb5462d\":\"UniOCI Registries\",\"u38ac18dd\":\"Unter Benutzer → Rollenberechtigungen verwaltet der Owner die tatsächlich wirksamen Aktionsrechte. Host-Grenzen und containerbezogene Ausführungsfreigaben gelten zusätzlich. Bereits zugelassene Operationen laufen zu Ende.\",\"uebefafef\":\"Unter Container findest du das Docker-Inventar. Nur ausdrücklich mit cuo.managed=true markierte Container lassen sich aktualisieren; CUO-Systemdienste bleiben geschützt.\",\"u80ec2865\":\"Unter Registries verbindest du universelle OCI-Quellen und optional Zot mit getrennten Pull-/Push-Zugängen. Unter Integrationen → GitHub richtest du deine eigene GitHub-App ein. Subscriptions ordnen vollständige Publish-Releases deinen Containern zu; lokal läuft zusätzlich ein periodischer API-Abgleich.\",\"ufb334f43\":\"Unter Richtlinien gelten Vorgaben für Global → Host → Gruppe → Container. Ausschlüsse bleiben wirksam. Lege Wartungsfenster fest und begrenze die Parallelität auf 1 bis 4. Globale, Host- und Gruppengrenzen gelten gemeinsam.\",\"ud9e3ce\":\"Unter Updates, Historie und Logs verfolgst du Jobs und Healthchecks. Bei „Eingriff erforderlich“ prüfe Logs und Agent-Journal, bevor du erneut startest. Datenbanken und Volumes bleiben erhalten; sichere wichtige Daten vor Updates.\",\"u817e73ea\":\"Unterstützte Aktionen (Verfügbarkeit wird bei der Abfrage geprüft)\",\"u76157afb\":\"Update freigeben\",\"uf95d8ef0\":\"Update planen\",\"u73d0d249\":\"Update verfügbar\",\"u61b57d0a\":\"Update-Benachrichtigungen anzeigen\",\"u8bf1eb0c\":\"Update-Benachrichtigungen sind in deinem Profil deaktiviert.\",\"ua936fad1\":\"Update-Freigabe anfordern\",\"u4a073349\":\"Update-Job angelegt. Freigaben und Fortschritt findest du unter Updates.\",\"uf0b8e124\":\"Update-Lauf abgeschlossen\",\"u151e5ff9\":\"Update-Lauf benötigt Aufmerksamkeit\",\"u822bb350\":\"Update-Lauf starten\",\"uc1e2db0b\":\"Update-Läufe\",\"ue48b24f9\":\"Update-Prüfung gestartet. Ergebnisse erscheinen live.\",\"u483075a5\":\"Updates\",\"ub9ca98a0\":\"Updates verfügbar\",\"u6021540\":\"Verarbeitet\",\"ufebb0dbb\":\"Verarbeitung\",\"uda38290\":\"Verbinde CUO mit deinem OIDC-Provider. Registriere dort einen Web-Client mit Authorization Code Flow und PKCE (S256).\",\"u1fa90024\":\"Verbindung aktiv\",\"u1dc9de5d\":\"Verbindung anlegen\",\"u3c40260c\":\"Verbindung bearbeiten\",\"ud1f30a0f\":\"Verbindung darf ausdrücklich private Netze erreichen\",\"u5170a8ee\":\"Verbindung prüfen\",\"u313b8f1d\":\"Verbindung und Ausführungsgrenze deines Docker-Hosts.\",\"u1f0d4da\":\"Verbunden\",\"u33f0ebca\":\"Verfügbare Updates prüfen, freigeben und ausführen.\",\"ueb14b669\":\"Verfügbare Version\",\"u1a8dddad\":\"Vergangene & aktive Läufe\",\"u6d1f35e6\":\"Vergangene Läufe, nächste Ausführungen und Telemetrie im Detail.\",\"ud313029c\":\"Verstärkt Text, Konturen und Fokusmarkierungen in der gesamten Shell, einschließlich Dialogen und Tabellen.\",\"uaca8746c\":\"Versuche\",\"u42605ed3\":\"Verwaltet\",\"uba04e240\":\"Verwendete Drittanbieter-Bibliotheken\",\"ucf39ebcc\":\"Viewer – nur lesen\",\"u103da517\":\"Vollständige Lizenzhinweise herunterladen\",\"uaef2bcf0\":\"Voraussetzung fehlt\",\"u77632903\":\"Vorgemerkt\",\"ud92b0cfe\":\"Vorhandene App / manuelle Einrichtung\",\"uea5c498f\":\"Vorher\",\"u854ede3d\":\"Vorherige Prozesse\",\"u8527f0b4\":\"Vorprüfung\",\"ua8424e18\":\"Vorschau, kein Ausführungsversprechen: Ein neuer Image-Digest, ein laufender Container und passende Freigaben sind erforderlich. Bereits angelegte geplante Jobs stehen in der Laufhistorie.\",\"u25f74c14\":\"Vorschau: nur Kandidaten\",\"uacb40424\":\"Wähle eine Farbfamilie. Heller und dunkler Modus funktionieren mit jeder Auswahl.\",\"u909f5c8c\":\"Wähle einen Container oder als Administrator „Alle auswählen“. Der Sammellauf startet alle ausführbaren bekannten Kandidaten sofort mit deiner ausdrücklichen Freigabe – auch außerhalb von Wartungsfenstern. Nicht verwaltete, ausgeschlossene, nur zu prüfende oder bereits aktive Container werden übersprungen. Einzeljobs beachten die normalen Freigaben und Wartungsfenster.\",\"ue2bbf8f2\":\"Waldgrün\",\"u65dfd139\":\"Warte auf Systemereignisse …\",\"u30de4f92\":\"Wartet\",\"uf48714ed\":\"Wartet auf Freigabe\",\"u8fa09273\":\"Wartungsfenster\",\"u7e69f6c\":\"Wartungsfenster angelegt.\",\"u410fe0bb\":\"Wartungsfenster erstellen\",\"uc127d000\":\"Wartungsfenster nicht mehr vorhanden.\",\"u9859aa9\":\"Wartungsfenster und automatische Updates planen.\",\"u11bb8f05\":\"Wartungsplan\",\"ue8947bdc\":\"Webhook-Secret (mindestens 32 Zeichen; bei Schlüsselwechsel ebenfalls angeben)\",\"u66a2afe3\":\"Weinrot\",\"u93fb5abb\":\"Weitere Protokolle laden\",\"u72a9e919\":\"Weitere Prozesse\",\"ubb29736a\":\"Widerrufen\",\"u7c7526a6\":\"Wiederaufnahme verarbeitet das bereits signierte Ereignis unter den aktuellen Freigaben und Richtlinien. Die ursprüngliche Zustellungs-ID verhindert doppelte Seiteneffekte.\",\"u2f0293cc\":\"Wiederaufnehmen\",\"u9e5e7e17\":\"Wiederholung geplant\",\"u7f68b257\":\"Willkommen zurück\",\"uc708891d\":\"Wird entfernt\",\"u5a0a2eb7\":\"Wirksame Ausführungsrechte\",\"ud17e062c\":\"Wochentage\",\"ufcb97383\":\"Workflows laden\",\"u27419f56\":\"Workspace\",\"ufcb40bb2\":\"Zeitplanung\",\"ue315edf7\":\"Zeitzone\",\"ueb2f75cb\":\"Ziel-ID oder Gruppenname\",\"ufe0874f6\":\"Zot\",\"uaa73efca\":\"Zugangsdaten werden nur schreibend übernommen. Leere Secret-Felder behalten den bisherigen Wert.\",\"u671832a2\":\"Zugehörige Logs\",\"u60ca65f1\":\"Zum Inhalt springen\",\"u3d6d2b00\":\"Zur Übersicht\",\"u16fd2281\":\"Zusätzlicher Host-Monitoring-Zugriff benötigt eine ausdrückliche containerbezogene Richtlinie. Privilegierte Host-Aktionen und schreibende System-Mounts bleiben gesperrt.\",\"u52a3570d\":\"Zustellungen\",\"uc475f7e0\":\"Alle auswählen – {v0} ausführbare Updates\",\"u1e194421\":\"{v0} · Pull-Credentials {v1} · Push-Credentials {v2}\",\"u6bb75aa0\":\"Automatische Löschung: deaktiviert. {v0} geschützte Digests. Externe Registry-Verbraucher müssen gesondert berücksichtigt werden.\",\"u3a4da940\":\"{v0} Bytes\",\"u68af47dd\":\"{v0} Images · {v1}\",\"u5465b535\":\"Quelle: {v0}\",\"ueef7cce3\":\"Komponente {v0}\",\"uefc35c39\":\"{v0} erfolgreich · {v1} Fehler · {v2} gesamt\",\"u71dd71a0\":\"{v0}–{v1} von {v2}\",\"u36b516eb\":\"{v0} · {v1} Läufe\",\"u1069af0b\":\"{v0}/3 Vergleichsläufe\",\"u174a546d\":\"{v0} Ereignisse · {v1} MiB Datenbank · {v2} MiB wiederverwendbar · {v3} offene Jobs\",\"uef42b55c\":\"Letzte Bereinigung: {v0} · {v1} Einträge gelöscht\",\"udbed494d\":\"{v0}: {v1} sortieren\",\"ua29d69eb\":\"{v0}–{v1} von {v2} Containern\",\"ub8b46510\":\"{v0} – {v1} Uhr\",\"uf5033bd4\":\"Automatische Updates – Gruppe „{v0}“\",\"ud2f613ff\":\"Max. {v0} parallele Updates · Healthcheck erforderlich\",\"ue44a9a5d\":\"Parallelität: max. {v0}\",\"u297bf65d\":\"{v0}: Ein neues Image steht bereit.\",\"u86ab1966\":\"Lauf {v0}{v1}\",\"ud6f546be\":\"{v0} Zeilen als {v1} heruntergeladen.\",\"u91cd310a\":\"{v0} Protokolleinträge gelöscht; {v1} offene Jobs geschützt.\",\"u73762e0d\":\"Sofortlauf gestartet: {v0} Updates, {v1} übersprungen. Fortschritt unter Updates.\",\"u55393f96\":\"{v0} laufende Container\",\"u66d4e82c\":\"{v0} Fehler · {v1} ausstehende Jobs\",\"u1ca16199\":\"Daten & Sitzung\",\"ud8765e2e\":\"Registry-Einstellungen\",\"u88b6b931\":\"Release-Subscriptions\",\"ubbe3311d\":\"Lauf / ID\",\"ueba7373d\":\"CSV-Logs\",\"ub17a14af\":\"Excel-Details\",\"ue887a37c\":\"Bis (UTC)\",\"u8989a239\":\"Von (UTC)\",\"ueaed9f34\":\"Lizenz & Drittanbieter\",\"u31311c9d\":\"Projekt / Quelle\",\"u88375ea6\":\"CUO · Apache-2.0\",\"u61e00255\":\"Mo\",\"u5fceb60e\":\"Di\",\"u5bdff8e3\":\"Mi\",\"u61ceb934\":\"Do\",\"u56d32511\":\"Fr\",\"u38025279\":\"Sa\",\"u42026237\":\"So\",\"u63535f27\":\"hinterlegt\",\"u45cea66d\":\"anonym\",\"ufcece231\":\"absteigend\",\"ufa50b304\":\"aufsteigend\",\"ubf72d5d5\":\" Min.\",\"ucc68c07d\":\"2 wichtig · 1 normal\",\"ubb785f0c\":\"03:00 – 04:00 Uhr\",\"uee8b8cd8\":\"So, 2. Nov. 2026\",\"u84e179c2\":\"Ungültige Darstellungs- oder Spracheinstellung\",\"u6eb37dc1\":\"Ungültiges Farbschema\",\"ud0b2173d\":\"Ungültiges Profil-Icon\",\"ub837d026\":\"Anzeigename benötigt 1–80 Zeichen\",\"udecaaec\":\"Protokoll-Aufbewahrung und Log-Reset verwalten\",\"ud529bb11\":\"Bestände und Protokolle lesen\",\"u2922e136\":\"Update-Prüfung starten\",\"ufaebcade\":\"Update-Jobs anfordern\",\"ufc73929f\":\"Updates freigeben und Sofortläufe starten\",\"u1ec3f5df\":\"Richtlinien und Wartungsfenster verwalten\",\"uec91529\":\"Lesenden Host-Monitoring-Zugriff freigeben\",\"uee5f215a\":\"Erlaubt zusätzliche containerbezogene Freigaben; die Host-Prüfungen bleiben wirksam.\",\"uda69886d\":\"Autorisierte Registry-Metadaten lesen\",\"ufa62bb59\":\"Registry-Verbindungen und Credentials verwalten\",\"u9ac26b5e\":\"Zugangsdaten können ersetzt, aber nie ausgelesen werden.\",\"uc1116a82\":\"Registry-Verbindung prüfen\",\"ubfb0c994\":\"Images per Digest importieren\",\"ue68fa52f\":\"Schreibt OCI-Inhalte in die Ziel-Registry.\",\"u3e5a1f2\":\"GitHub-App verbinden und verwalten\",\"ud016dc0a\":\"GitHub-Zustellungen und Release-Sets lesen\",\"ud571844f\":\"Fehlgeschlagene Zustellungen wiederaufnehmen\",\"ude74486b\":\"Release-Subscriptions verwalten\",\"u9236ee35\":\"Automatisierung benötigt zusätzlich ausführbare Container-Richtlinien.\",\"ufac7c541\":\"Untergeordnete Benutzer verwalten\",\"ude1be533\":\"Rollenberechtigungen verwalten\",\"u5ae61eb3\":\"Bitte anmelden\",\"u1f3967c3\":\"Profil-Icon\",\"ucfa5178e\":\"Redirect-URI\",\"u29f02872\":\"Issuer-URL\",\"u4ccfcf14\":\"Discovery-URL (optional)\",\"u15747a2c\":\"Client-ID\",\"udcb24324\":\"Client-Authentifizierung\",\"u495b099c\":\"Container-Einstellungen\",\"ucdcc70bd\":\"Image-Quelle\",\"ue00f548d\":\"Image-Quelle & Release-Zuordnung\",\"u8e76c58b\":\"IANA-Zeitzone\",\"u74151505\":\"Update-Modus\",\"u81a8e178\":\"Grund / Ticket\",\"u3d90e3be\":\"Benutzer & Rollen\",\"u9aef2739\":\"API-Endpunkt\",\"u47a7a9b6\":\"Push-Benutzername\",\"u94f160b1\":\"Retention-Vorschau\",\"u3e789c05\":\"Quell-Repository\",\"ub8f2e18d\":\"Image-Digest\",\"uda7550df\":\"Ziel-Registry\",\"u94f84aac\":\"Ziel-Repository\",\"u62bb813f\":\"OCI-Artefakt\",\"udf70847e\":\"App-ID\",\"u2eddaf9d\":\"Installation-ID\",\"uaba8d75c\":\"GitHub-Verbindungen\",\"u842cc79b\":\"GitHub-Verbindung\",\"u125dafa6\":\"Publish-Workflow\",\"u69f7c94\":\"Release-Kanal\",\"u65d835de\":\"Quell-Registry\",\"u97e7f8cf\":\"Ziel-Container\",\"ucd5246f2\":\"Zot-Import-Namespace\",\"u8232c71\":\"Container & Phasen\",\"u99c2c5bd\":\"Docker-ID\",\"u41cb87c4\":\"Excel (.xlsx)\",\"ue0e40864\":\"CSV (UTF-8)\",\"u584ff569\":\"Log-Aufbewahrung\",\"u62cb0b05\":\"Zyklus (Stunden)\",\"ue14aa0d2\":\"Update-Richtlinien\",\"u925c3273\":\"Docker-Hosts\",\"u88c678e6\":\"Workspace-Einstellungen\",\"u35a186b4\":\" ausgeschlossen\",\"uc7869dbf\":\"Ein\",\"u8cee7058\":\"Aus\"},\"notificationsOpen\":false,\"profileOpen\":false,\"containerTab\":\"overview\",\"dismissed\":[],\"oidc\":{},\"oidcConfig\":null,\"page\":\"dashboard\",\"sidebarCollapsed\":false,\"sidebarNarrow\":false,\"notice\":\"\",\"toasts\":[],\"error\":false,\"demo\":false,\"user\":{\"name\":\"\",\"role\":\"\"},\"containers\":[],\"jobs\":[],\"events\":[],\"policies\":[],\"windows\":[],\"hosts\":[],\"users\":[],\"query\":\"\",\"filter\":\"all\",\"sort\":\"name\",\"sortDirection\":\"asc\",\"historySort\":\"createdAt\",\"historySortDirection\":\"desc\",\"offset\":0,\"calendar\":\"2026-11\",\"selectedDate\":\"2026-11-04\",\"dialog\":\"\",\"selected\":\"\",\"live\":true,\"contrastMode\":\"normal\",\"themeToggleIcon\":\"moon\",\"themeToggleLabel\":\"Farbschema wechseln: Dunklen Modus aktivieren\",\"notifications\":[],\"notificationCount\":\"0\",\"notificationClass\":\"is-hidden\",\"notificationsExpanded\":\"false\",\"profileExpanded\":\"false\",\"avatarTextClass\":\"\",\"avatarIconClass\":\"is-hidden\",\"avatarName\":\"user\",\"avatarPack\":\"cuo\",\"title\":\"Dashboard\",\"description\":\"Übersicht über deine Container, Updates und den Systemstatus.\",\"total\":\"0\",\"monitored\":\"0\",\"excludedCount\":\"0\",\"updateCount\":\"0\",\"updateHint\":\"0 laufende Container\",\"currentCount\":\"0\",\"systemTitle\":\"Alles in Ordnung\",\"systemDetail\":\"0 Fehler · 0 ausstehende Jobs\",\"userInitials\":\"CU\",\"shellClass\":\"cuo-shell is-hidden\",\"sidebarExpanded\":\"true\",\"sidebarToggleLabel\":\"Navigation einklappen\",\"authClass\":\"auth-wrap\",\"dashboardClass\":\"dashboard-grid\",\"workspaceClass\":\"is-hidden\",\"mainContentClass\":\"main-content\",\"demoClass\":\"is-hidden\",\"pageTitle\":\"Dashboard\",\"nextDate\":\"Kein Fenster geplant\",\"nextTime\":\"Wartungsfenster erstellen\",\"navdashboard\":\"nav-item cuo-action active\",\"routedashboard\":\"route-panel\",\"navcontainers\":\"nav-item cuo-action\",\"routecontainers\":\"is-hidden\",\"navupdates\":\"nav-item cuo-action\",\"routeupdates\":\"is-hidden\",\"navschedule\":\"nav-item cuo-action\",\"routeschedule\":\"is-hidden\",\"navpolicies\":\"nav-item cuo-action\",\"routepolicies\":\"is-hidden\",\"navhistory\":\"nav-item cuo-action\",\"routehistory\":\"is-hidden\",\"navlogs\":\"nav-item cuo-action\",\"routelogs\":\"is-hidden\",\"navsettings\":\"nav-item cuo-action\",\"routesettings\":\"is-hidden\",\"navhosts\":\"nav-item cuo-action\",\"routehosts\":\"is-hidden\",\"navusers\":\"nav-item cuo-action\",\"routeusers\":\"is-hidden\",\"navintegrations\":\"nav-item cuo-action\",\"routeintegrations\":\"is-hidden\",\"navregistries\":\"nav-item cuo-action\",\"routeregistries\":\"is-hidden\",\"navregistry\":\"nav-item cuo-action\",\"routeregistry\":\"is-hidden\",\"navrepositories\":\"nav-item cuo-action\",\"routerepositories\":\"is-hidden\",\"navgithub\":\"nav-item cuo-action\",\"routegithub\":\"is-hidden\",\"navdeliveries\":\"nav-item cuo-action\",\"routedeliveries\":\"is-hidden\",\"navsubscriptions\":\"nav-item cuo-action\",\"routesubscriptions\":\"is-hidden\",\"navpermissions\":\"nav-item cuo-action\",\"routepermissions\":\"is-hidden\"}"
  } }
 state cuo.shell type object preserve { initial {
    id "cuo-shell"
    layoutEngine "document-flow"
    viewTemplate {
      class "cuo-root"
      attributes {
        data-theme "$model.cuo.vm.theme"
        data-palette "$model.cuo.vm.palette"
        data-contrast "$model.cuo.vm.contrastMode"
        lang "$model.cuo.vm.locale"
      }
      children [
        {
          type "element"
          tag "a"
          class "skip-link"
          attributes {
            href "#main-content"
          }
          children [

          ]
          text "$model.cuo.vm.labels.u60ca65f1"
        }
        {
          type "element"
          tag "div"
          class "$model.cuo.vm.authClass"
          attributes {

          }
