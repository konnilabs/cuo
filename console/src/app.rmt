                            }
                          ]
                        }
                        {
                          type "element"
                          tag "section"
                          class "$model.cuo.vm.routesettings"
                          attributes {
                            aria-label "settings"
                          }
                          children [
                            {
                              type "element"
                              tag "x-cuo-workspace"
