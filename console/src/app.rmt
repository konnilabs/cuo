                          type "element"
                          tag "section"
                          class "$model.cuo.vm.routehosts"
                          attributes {
                            aria-label "hosts"
                          }
                          children [
                            {
                              type "element"
                              tag "x-host-health"
                              class "cuo-widget"
                              attributes {
                                data-cuo-widget "true"
                                data-view "$model.cuo.vm.serialized"
                              }
                              children [

                              ]
                            }
                          ]
                        }
                        {
                          type "element"
