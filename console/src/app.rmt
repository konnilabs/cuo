              type "element"
              tag "x-cuo-auth"
              class "cuo-widget"
              attributes {
                data-cuo-widget "true"
                data-view "$model.cuo.vm.serialized"
              }
              children [

              ]
            }
          ]
        }
        {
          type "element"
          tag "div"
          class "$model.cuo.vm.shellClass"
          attributes {
            data-theme "$model.cuo.vm.theme"
          }
          children [
            {
              type "element"
